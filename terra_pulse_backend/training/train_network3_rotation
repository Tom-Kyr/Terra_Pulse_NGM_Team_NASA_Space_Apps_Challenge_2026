import os
import random
import torch
import torch.nn as nn
import torch.optim as optim

ROOT_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


class CropRotationNeuralNet(nn.Module):
    def __init__(self, input_dim=5):
        super().__init__()
        self.fc1 = nn.Linear(input_dim, 20)
        self.fc2 = nn.Linear(20, 12)
        self.fc3 = nn.Linear(12, 4)  # [Legumes, Alfalfa, Wheat, Sorghum]

    def forward(self, x):
        x = torch.relu(self.fc1(x))
        x = torch.relu(self.fc2(x))
        return torch.sigmoid(self.fc3(x))


def build_dataset(n_samples=1500):
    random.seed(202)
    X, y = [], []
    for _ in range(n_samples):
        aridity = random.uniform(0.15, 0.95)
        om = random.uniform(0.20, 0.95)
        slope = random.uniform(0.02, 0.90)
        moisture = random.uniform(0.08, 0.45)
        nitrogen = random.uniform(0.15, 0.90)

        legume = max(0.3, min(0.97, 0.65 + 0.25 * aridity + 0.15 * (1.0 - nitrogen) + random.gauss(0, 0.02)))
        alfalfa = max(0.25, min(0.96, 0.80 - 0.25 * aridity + 0.15 * moisture + random.gauss(0, 0.02)))
        wheat = max(0.25, min(0.95, 0.60 + 0.20 * nitrogen - 0.18 * slope + random.gauss(0, 0.02)))
        sorghum = max(0.3, min(0.96, 0.55 + 0.32 * aridity + 0.08 * om + random.gauss(0, 0.02)))

        X.append([aridity, om, slope, moisture, nitrogen])
        y.append([legume, alfalfa, wheat, sorghum])
    return torch.tensor(X, dtype=torch.float32), torch.tensor(y, dtype=torch.float32)


def train():
    X, y = build_dataset()
    model = CropRotationNeuralNet(input_dim=5)
    criterion = nn.MSELoss()
    optimizer = optim.Adam(model.parameters(), lr=0.007)

    for epoch in range(1, 121):
        optimizer.zero_grad()
        loss = criterion(model(X), y)
        loss.backward()
        optimizer.step()
        if epoch % 30 == 0 or epoch == 1:
            print(f"[Network 3 - Rot.]  Epoch {epoch:3d}/120 | Loss: {loss.item():.5f}")

    out_path = os.path.join(ROOT_DIR, "terrapulse_rotation_model.pth")
    torch.save(model.state_dict(), out_path)
    print(f"Saved Network 3 weights -> {out_path}")


if __name__ == "__main__":
    train()